{
  "name": "takwira",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "description": "Football match finding app monorepo",
  "scripts": {
    "dev:frontend": "pnpm --filter @takwira/frontend dev",
    "build:frontend": "pnpm --filter @takwira/frontend build",
    "preview:frontend": "pnpm --filter @takwira/frontend preview",
    "dev:backend": "pnpm --filter @takwira/backend dev",
    "build:backend": "pnpm --filter @takwira/backend build",
    "start:backend": "pnpm --filter @takwira/backend start",
    "build:shared": "pnpm --filter @takwira/shared build",
    "build": "pnpm build:shared && pnpm build:frontend && pnpm build:backend",
    "lint": "pnpm --filter @takwira/frontend lint",
    "format": "pnpm --filter @takwira/frontend format"
  },
  "devDependencies": {},
  "dependencies": {}
}
